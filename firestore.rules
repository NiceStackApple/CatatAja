rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default safety net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User-specific workspace document containing all user state
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
